# Copy to .env (never commit .env). Required in production:
SECRET_KEY=replace-with-64-random-characters
# Optional:
# DATABASE_URL=postgresql://ciwt:change-me@db:5432/ciwt
# SSO_<SLUG>_CLIENT_SECRET=...        # OIDC client secret per institution, kept out of the database
# NOVAK_AI_API_KEY=...                # optional grounded AI tutor rephrasing
# WEB_CONCURRENCY=1                   # keep 1 with SQLite; raise with PostgreSQL
