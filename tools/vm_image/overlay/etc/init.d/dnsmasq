#!/bin/sh
# SysV-style init script (BusyBox start-stop-daemon). Enable at boot: ln -s ../init.d/dnsmasq /etc/init.d/S50dnsmasq
DAEMON="dnsmasq"; EXE="/usr/sbin/dnsmasq"; PIDFILE="/var/run/$DAEMON.pid"
ARGS="--pid-file=/var/run/dnsmasq.pid"
[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"
start() { printf 'Starting %s: ' "$DAEMON"
  [ -x "$EXE" ] || { echo "FAIL ($EXE not found)"; logger -t init "$DAEMON: $EXE not found"; return 1; }
  dnsmasq --test -q 2>/dev/null || { echo "FAIL (config error: $(dnsmasq --test 2>&1 | head -1))"; return 1; }
  start-stop-daemon -S -q  -p "$PIDFILE" -x "$EXE" -- $ARGS && { echo OK; logger -t init "$DAEMON started"; } || { echo FAIL; logger -t init "$DAEMON failed to start"; return 1; } }
stop() { printf 'Stopping %s: ' "$DAEMON"; start-stop-daemon -K -q -p "$PIDFILE" -x "$EXE" && { rm -f "$PIDFILE"; echo OK; logger -t init "$DAEMON stopped"; } || { echo FAIL; return 1; } }
status() { if start-stop-daemon -K -t -q -p "$PIDFILE" -x "$EXE" 2>/dev/null; then echo "$DAEMON is running (pid $(cat $PIDFILE))"; else echo "$DAEMON is stopped"; return 3; fi }
case "$1" in start|stop|status) "$1";; restart|reload) stop; sleep 1; start;; *) echo "Usage: $0 {start|stop|restart|status}"; exit 1;; esac
